datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  password         Password?
  notes            Note[]
  isMetadata       isMetadata?
  isImage          isImage?
  isUpload         isUpload?  
  isValidate       isValidate?
  isStorage        isStorage?
  directory        String?
  apiKeys          apiKey[]
  previousUpload   previousUpload[]
  selectedProvider String?
}

model Password {
  hash String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String @unique
}

model Note {
  id    String @id @default(cuid())
  title String
  body  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String
}

model isMetadata {
  id     String  @id @default(cuid())
  isTrue Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String @unique
}

model isStorage {
  id     String  @id @default(cuid())
  isTrue Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String @unique
}

model isImage {
  id     String  @id @default(cuid())
  isTrue Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String @unique
}

model isValidate {
  id     String  @id @default(cuid())
  isTrue Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String @unique
}

model isUpload {
  id     String  @id @default(cuid())
  isTrue Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String @unique
}

model previousUpload {
  id        String           @id @default(cuid())
  name      String?
  baseURI   String
  imageURI  String
  fileNames fileNameObject[]
  numFiles  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String
}

model fileNameObject {
  id        String   @id @default(cuid())
  fileName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   previousUpload @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String
}

model apiKey {
  id        String   @id @default(cuid())
  provider  String
  key       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String
}
